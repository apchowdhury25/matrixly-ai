# Matrixly Observability stack — copy to .env and customize
# cp .env.example .env

# Crawl4AI (optional API token for production)
CRAWL4AI_API_TOKEN=
MAX_CONCURRENT_BROWSERS=4

# Grafana admin (CHANGE IN PRODUCTION)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=matrixly-change-me
GRAFANA_ROOT_URL=http://127.0.0.1:3000
