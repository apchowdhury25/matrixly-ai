# Matrixly Starter Pack — copy to .env (never commit .env)

STARTER_API_KEY=change-me-admin-key
STARTER_WIDGET_KEY=pk_live_change-me

# Optional shared Grok key (agents also have their own .env)
XAI_API_KEY=

CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:8800,https://matrixly.world,https://www.matrixly.world

BUSINESS_NAME=Matrixly Demo Co
SUPPORT_EMAIL=hello@example.com
TIMEZONE=America/Chicago

# Agent service URLs (run each agent, or leave defaults)
SUPPORTFORGE_URL=http://127.0.0.1:8787
SUPPORTFORGE_API_KEY=change-me-admin-key
SUPPORTFORGE_ENABLED=true

BOOKWISE_URL=http://127.0.0.1:8790
BOOKWISE_API_KEY=change-me-admin-key
BOOKWISE_ENABLED=true

INVOICEFORGE_URL=http://127.0.0.1:8791
INVOICEFORGE_API_KEY=change-me-admin-key
INVOICEFORGE_ENABLED=true

# When true, pack can also read sibling agents/*/data for offline analytics
LOCAL_DATA_FALLBACK=true
