# Matrixly ETF Portfolio Analyzer — copy to .env

ETF_API_KEY=change-me-admin-key
ETF_WIDGET_KEY=pk_live_change-me

XAI_API_KEY=
XAI_MODEL=grok-4-1-fast-reasoning
XAI_BASE_URL=https://api.x.ai/v1

CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:8797,https://matrixly.world,https://www.matrixly.world

DEFAULT_TICKER=QQQI
BUSINESS_NAME=Matrixly Demo Co
TIMEZONE=America/Chicago

# Optional Notion save (free user integration — never required for analysis)
# NOTION_API_KEY=
# NOTION_PARENT_PAGE_ID=

COST_INPUT_PER_1M=5.0
COST_OUTPUT_PER_1M=15.0
