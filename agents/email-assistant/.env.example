# Copy to .env and fill in. NEVER commit .env or paste secrets into chat.

# Active mailbox profile: gmail | hostinger
EMAIL_PROFILE=gmail

# Backend:
#   gmail  = Gmail API OAuth (recommended for most SMBs)
#   imap   = Hostinger / Outlook / Gmail App Password
#   test   = sample inbox (no real mail) — or: python -m src.cli test-mode
EMAIL_BACKEND=gmail

# ---------- Gmail API OAuth (recommended) ----------
# 1. Follow scripts/setup_oauth.md
# 2. Save Desktop client JSON as data/credentials.json
# 3. Run: python -m src.cli connect-gmail
# Optional path overrides:
# GMAIL_CREDENTIALS_FILE=data/credentials.json
# GMAIL_TOKEN_FILE=data/token.json
# GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.readonly,https://www.googleapis.com/auth/gmail.send,https://www.googleapis.com/auth/gmail.modify,https://www.googleapis.com/auth/gmail.labels

# Primary address shown on briefs (optional; taken from Google profile after OAuth)
EMAIL_GMAIL_USER=you@yourbusiness.com
# EMAIL_ASSISTANT_PRIMARY=you@yourbusiness.com

# ---------- Gmail via IMAP (App Password) — only if not using OAuth ----------
# EMAIL_BACKEND=imap
# EMAIL_PROFILE=gmail
# EMAIL_GMAIL_USER=you@yourbusiness.com
# EMAIL_GMAIL_PASSWORD=your-gmail-app-password-here
# https://myaccount.google.com/apppasswords

# ---------- Hostinger / Outlook / other IMAP ----------
# EMAIL_BACKEND=imap
# EMAIL_PROFILE=hostinger
# EMAIL_HOSTINGER_USER=you@yourdomain.com
# EMAIL_HOSTINGER_PASSWORD=your-mailbox-password-here
# Or generic:
# EMAIL_IMAP_HOST=imap.hostinger.com
# EMAIL_IMAP_PORT=993
# EMAIL_IMAP_USER=you@yourdomain.com
# EMAIL_IMAP_PASSWORD=********
# EMAIL_SMTP_HOST=smtp.hostinger.com
# EMAIL_SMTP_PORT=465

# Where to email the daily brief (defaults to your mailbox)
# EMAIL_SUMMARY_TO=you@yourbusiness.com

# Optional: smarter triage + draft wording via Grok (xAI)
# XAI_API_KEY=
