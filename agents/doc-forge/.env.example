# Matrixly DocForge — copy to .env (never commit .env)

XAI_API_KEY=
XAI_MODEL=grok-4-1-fast-reasoning
XAI_BASE_URL=https://api.x.ai/v1

DOCFORGE_API_KEY=change-me-admin-key
DOCFORGE_WIDGET_KEY=pk_live_change-me

CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:8796,https://matrixly.world,https://www.matrixly.world

HITL_MODE=external_only
HITL_AUTO_APPROVE=false

BUSINESS_NAME=Matrixly Demo Co
SUPPORT_EMAIL=docs@example.com
TIMEZONE=America/Chicago

# CRM client data: local | hubspot | salesforce
CRM_BACKEND=local

# HUBSPOT_ACCESS_TOKEN=
# SF_INSTANCE_URL=
# SF_ACCESS_TOKEN=

COST_INPUT_PER_1M=5.0
COST_OUTPUT_PER_1M=15.0
