# ConnectForge (Twilio Connect Agent) — copy to .env (never commit .env)

# Twilio (required for live SMS / calls)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+17135550100

# Optional Conversations Service SID (auto-created if empty when API allows)
TWILIO_CONVERSATIONS_SERVICE_SID=

# Comma-separated E.164 numbers allowed in Test Mode (Twilio trial verified numbers)
TWILIO_VERIFIED_NUMBERS=+17135550123

# true = only send to verified numbers (recommended for trial)
CONNECTFORGE_TEST_MODE=true

# HITL: require human approval before outbound SMS
HITL_REQUIRE_OUTBOUND=true
HITL_MODE=external_only
HITL_AUTO_APPROVE=false

# Matrixly admin / widget keys
CONNECTFORGE_API_KEY=change-me-admin-key
CONNECTFORGE_WIDGET_KEY=pk_live_change-me

# Optional Grok for AI replies (falls back to rule templates if empty)
XAI_API_KEY=
XAI_MODEL=grok-4-1-fast-reasoning
XAI_BASE_URL=https://api.x.ai/v1

# Public base URL for Twilio webhooks (use ngrok/cloudflare tunnel in dev)
PUBLIC_BASE_URL=http://localhost:8802

BUSINESS_NAME=Matrixly Connect Demo
SUPPORT_EMAIL=connect@example.com
TIMEZONE=America/Chicago
CORS_ORIGINS=http://localhost:8080,http://localhost:8802,https://matrixly.world
