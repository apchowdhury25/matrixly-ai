# Matrixly MeetWise — copy to .env (never commit .env)

XAI_API_KEY=
XAI_MODEL=grok-4-1-fast-reasoning
XAI_BASE_URL=https://api.x.ai/v1

MEETWISE_API_KEY=change-me-admin-key
MEETWISE_WIDGET_KEY=pk_live_change-me

CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:8793,https://matrixly.world,https://www.matrixly.world

HITL_MODE=external_only
HITL_AUTO_APPROVE=false

BUSINESS_NAME=Matrixly Demo Co
SUPPORT_EMAIL=meetings@example.com
TIMEZONE=America/Chicago

# Transcript source: upload | zoom | teams | google
MEETING_BACKEND=upload

# Zoom (optional)
# ZOOM_ACCOUNT_ID=
# ZOOM_CLIENT_ID=
# ZOOM_CLIENT_SECRET=
# ZOOM_JWT_TOKEN=

# Microsoft Teams / Graph (optional)
# TEAMS_TENANT_ID=
# TEAMS_CLIENT_ID=
# TEAMS_CLIENT_SECRET=

# Google Meet / Drive transcript export (optional)
# GOOGLE_CREDENTIALS_PATH=credentials.json
# GOOGLE_TOKEN_PATH=token.json

# CRM backend: local | salesforce_export
CRM_BACKEND=local

# Recap email (optional SMTP / log only)
EMAIL_BACKEND=log
# EMAIL_SMTP_HOST=
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USER=
# EMAIL_SMTP_PASSWORD=
# EMAIL_FROM=meetings@example.com

COST_INPUT_PER_1M=5.0
COST_OUTPUT_PER_1M=15.0
