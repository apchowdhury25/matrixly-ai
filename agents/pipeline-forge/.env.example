# Matrixly PipelineForge — copy to .env (never commit .env)

XAI_API_KEY=
XAI_MODEL=grok-4-1-fast-reasoning
XAI_BASE_URL=https://api.x.ai/v1

PIPELINEFORGE_API_KEY=change-me-admin-key
PIPELINEFORGE_WIDGET_KEY=pk_live_change-me

CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:8795,https://matrixly.world,https://www.matrixly.world

HITL_MODE=external_only
HITL_AUTO_APPROVE=false

BUSINESS_NAME=Matrixly Demo Co
SUPPORT_EMAIL=sales@example.com
TIMEZONE=America/Chicago

# CRM backend: local | hubspot | salesforce
CRM_BACKEND=local

# HubSpot (optional)
# HUBSPOT_ACCESS_TOKEN=
# HUBSPOT_PIPELINE_ID=

# Salesforce (optional)
# SF_INSTANCE_URL=https://your-domain.my.salesforce.com
# SF_ACCESS_TOKEN=
# SF_API_VERSION=v59.0

COST_INPUT_PER_1M=5.0
COST_OUTPUT_PER_1M=15.0
