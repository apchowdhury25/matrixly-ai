# Matrixly Invoice Processor
XAI_API_KEY=
# Pydantic AI model string (provider:model)
INVOICE_PROCESSOR_MODEL=xai:grok-4.5
# Fallbacks if provider rejects the preferred name
INVOICE_PROCESSOR_MODEL_FALLBACK=xai:grok-4-1-fast-reasoning

# Optional OpenAI-compat override (if not using native xai: provider)
# OPENAI_BASE_URL=https://api.x.ai/v1
# OPENAI_API_KEY=

INVOICE_PROCESSOR_API_KEY=change-me-admin-key
HITL_AUTO_APPROVE=false
CURRENCY_DEFAULT=USD
AMOUNT_REVIEW_THRESHOLD=10000
