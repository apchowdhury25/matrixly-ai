# Matrixly SocialForge — copy to .env (never commit .env)

XAI_API_KEY=
XAI_MODEL=grok-4-1-fast-reasoning
XAI_BASE_URL=https://api.x.ai/v1

SOCIALFORGE_API_KEY=change-me-admin-key
SOCIALFORGE_WIDGET_KEY=pk_live_change-me

CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:8794,https://matrixly.world,https://www.matrixly.world

HITL_MODE=external_only
HITL_AUTO_APPROVE=false

BUSINESS_NAME=Matrixly Demo Brand
SUPPORT_EMAIL=social@example.com
TIMEZONE=America/Chicago

# Publish backend: local | buffer | meta | linkedin
PUBLISH_BACKEND=local

# Buffer (optional)
# BUFFER_ACCESS_TOKEN=
# BUFFER_PROFILE_IDS=

# Meta (Facebook / Instagram Graph — optional)
# META_ACCESS_TOKEN=
# META_PAGE_ID=
# META_IG_USER_ID=

# LinkedIn (optional)
# LINKEDIN_ACCESS_TOKEN=
# LINKEDIN_ORG_URN=
# LINKEDIN_PERSON_URN=

COST_INPUT_PER_1M=5.0
COST_OUTPUT_PER_1M=15.0
