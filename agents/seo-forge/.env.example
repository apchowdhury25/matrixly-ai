# Matrixly SEOForge — copy to .env (never commit .env)

XAI_API_KEY=
XAI_MODEL=grok-4-1-fast-reasoning
XAI_BASE_URL=https://api.x.ai/v1

SEOFORGE_API_KEY=change-me-admin-key
SEOFORGE_WIDGET_KEY=pk_live_change-me

CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:8798,https://matrixly.world,https://www.matrixly.world

HITL_MODE=external_only
HITL_AUTO_APPROVE=false

BUSINESS_NAME=Matrixly Demo Brand
SUPPORT_EMAIL=seo@example.com
TIMEZONE=America/Chicago

# Publishing backends: local | buffer | hootsuite | wordpress
PUBLISH_BACKEND=local

# Buffer (optional)
# BUFFER_ACCESS_TOKEN=
# BUFFER_PROFILE_IDS=

# Hootsuite (optional)
# HOOTSUITE_ACCESS_TOKEN=

# WordPress (optional)
# WORDPRESS_SITE_URL=https://example.com
# WORDPRESS_USERNAME=
# WORDPRESS_APP_PASSWORD=

COST_INPUT_PER_1M=5.0
COST_OUTPUT_PER_1M=15.0
