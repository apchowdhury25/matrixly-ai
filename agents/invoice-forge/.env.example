# Matrixly InvoiceForge — copy to .env (never commit .env)

XAI_API_KEY=
XAI_MODEL=grok-4-1-fast-reasoning
XAI_VISION_MODEL=grok-2-vision-1212
XAI_BASE_URL=https://api.x.ai/v1

INVOICEFORGE_API_KEY=change-me-admin-key
INVOICEFORGE_WIDGET_KEY=pk_live_change-me

CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:8791,https://matrixly.world,https://www.matrixly.world,https://matrixbazaar.com

HITL_MODE=exceptions_only
HITL_AUTO_APPROVE=false

BUSINESS_NAME=Matrixly Demo Co
SUPPORT_EMAIL=ap@example.com
TIMEZONE=America/Chicago

# Accounting backend: csv | quickbooks | xero
ACCOUNTING_BACKEND=csv

# QuickBooks Online (optional stub)
# QBO_CLIENT_ID=
# QBO_CLIENT_SECRET=
# QBO_REALM_ID=
# QBO_ACCESS_TOKEN=
# QBO_REFRESH_TOKEN=

# Xero (optional stub)
# XERO_CLIENT_ID=
# XERO_CLIENT_SECRET=
# XERO_TENANT_ID=
# XERO_ACCESS_TOKEN=

# Email watch (optional IMAP)
EMAIL_BACKEND=none
# EMAIL_BACKEND=imap
# EMAIL_IMAP_HOST=imap.hostinger.com
# EMAIL_IMAP_PORT=993
# EMAIL_IMAP_USER=
# EMAIL_IMAP_PASSWORD=

COST_INPUT_PER_1M=5.0
COST_OUTPUT_PER_1M=15.0
