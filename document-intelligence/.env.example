# Matrixly Document Intelligence — copy to .env and adjust
# https://matrixly.net · anwar.chowdhury@matrixly.net
#
# NOTE: Database, API paths, and status codes are always English.
# Front-end locales (en, es, fr, ar, bn, de, ms) apply only to the website UI.

ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api/v1

# RLS-bound app user (no BYPASSRLS)
DATABASE_URL=postgresql+asyncpg://matrixly_app:matrixly@localhost:5432/matrixly

# Service / worker role (BYPASSRLS) — never expose to browsers or public agents
DATABASE_SERVICE_URL=postgresql+asyncpg://matrixly_service:matrixly_service@localhost:5432/matrixly

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false

# Auth — use a strong secret in production
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_AUDIENCE=matrixly-api
API_KEY_HEADER=X-API-Key

# Local file storage for uploads
DOCUMENT_STORAGE_DIR=./data/uploads
MAX_UPLOAD_BYTES=26214400

# Embeddings: placeholder | openai
EMBEDDING_PROVIDER=placeholder
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1

CHUNK_SIZE_CHARS=1200
CHUNK_OVERLAP_CHARS=150

REDIS_URL=redis://localhost:6379/0
ARQ_QUEUE_NAME=matrixly:documents

SUPPORT_EMAIL=anwar.chowdhury@matrixly.net
PUBLIC_SITE=https://matrixly.net
